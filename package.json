{
  "name": "@mirafive/protocol",
  "version": "2.2.0",
  "description": "The MIRA FIVE wire format: event and batch types, limits, eventIdFor and the helpers every MIRA FIVE SDK shares. No dependencies.",
  "keywords": [
    "analytics",
    "attribution",
    "mira-five",
    "mirafive",
    "protocol",
    "schema"
  ],
  "homepage": "https://github.com/mirafive/protocol#readme",
  "bugs": {
    "url": "https://github.com/mirafive/protocol/issues"
  },
  "license": "MIT",
  "author": "Cloo GmbH <hallo@mirafive.io> (https://mirafive.io)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mirafive/protocol.git"
  },
  "bin": {
    "mirafive-validate": "./dist/cli.js"
  },
  "files": [
    "dist",
    "fixtures",
    "schema"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./batch.schema.json": "./schema/batch.schema.json",
    "./package.json": "./package.json",
    "./fixtures/*": "./fixtures/*"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "bun run build.ts",
    "check": "bun run format:check && bun run lint && bun run typecheck && bun run test && bun run build",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "lint": "oxlint",
    "test": "bun test",
    "typecheck": "bun check"
  },
  "devDependencies": {
    "@types/bun": "^1.4.4",
    "oxfmt": "^0.77.0",
    "oxlint": "^1.92.0",
    "oxlint-tsgolint": "^7.0.2006",
    "typescript": "^7.0.2"
  },
  "packageManager": "bun@1.4.4"
}
