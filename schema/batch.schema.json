{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "key": {
      "type": "string",
      "maxLength": 100
    },
    "sent_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
    },
    "stream": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "seq": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 2147483647
    },
    "events": {
      "minItems": 1,
      "maxItems": 100,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "event_id": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
          },
          "type": {
            "type": "string",
            "enum": ["track", "page", "screen", "identify", "group"]
          },
          "event": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120,
            "pattern": "^\\P{Cc}+$"
          },
          "timestamp": {
            "type": "string",
            "format": "date-time",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
          },
          "anonymous_id": {
            "type": "string",
            "maxLength": 200
          },
          "user_id": {
            "type": "string",
            "maxLength": 200
          },
          "session_id": {
            "type": "string",
            "maxLength": 200
          },
          "group_id": {
            "type": "string",
            "maxLength": 200
          },
          "properties": {
            "default": {},
            "type": "object",
            "propertyNames": {
              "type": "string",
              "minLength": 1,
              "maxLength": 100
            },
            "additionalProperties": {
              "anyOf": [
                {
                  "type": "string",
                  "maxLength": 2048
                },
                {
                  "type": "number"
                },
                {
                  "type": "boolean"
                },
                {
                  "type": "null"
                },
                {
                  "maxItems": 50,
                  "type": "array",
                  "items": {
                    "anyOf": [
                      {
                        "type": "string",
                        "maxLength": 2048
                      },
                      {
                        "type": "number"
                      },
                      {
                        "type": "boolean"
                      }
                    ]
                  }
                }
              ]
            }
          },
          "traits": {
            "type": "object",
            "propertyNames": {
              "type": "string",
              "minLength": 1,
              "maxLength": 100
            },
            "additionalProperties": {
              "anyOf": [
                {
                  "type": "string",
                  "maxLength": 2048
                },
                {
                  "type": "number"
                },
                {
                  "type": "boolean"
                },
                {
                  "type": "null"
                },
                {
                  "maxItems": 50,
                  "type": "array",
                  "items": {
                    "anyOf": [
                      {
                        "type": "string",
                        "maxLength": 2048
                      },
                      {
                        "type": "number"
                      },
                      {
                        "type": "boolean"
                      }
                    ]
                  }
                }
              ]
            }
          },
          "external_ids": {
            "type": "object",
            "propertyNames": {
              "type": "string",
              "enum": [
                "stripe_customer",
                "revenuecat_app_user",
                "shopify_customer",
                "shopware_customer"
              ]
            },
            "additionalProperties": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            }
          },
          "revenue": {
            "type": "object",
            "properties": {
              "amount": {
                "type": "integer",
                "minimum": -1000000000000000,
                "maximum": 1000000000000000
              },
              "currency": {
                "type": "string",
                "minLength": 3,
                "maxLength": 3
              },
              "entry_id": {
                "type": "string",
                "maxLength": 200
              },
              "kind": {
                "type": "string",
                "enum": ["charge", "subscription_payment", "refund", "dispute", "dispute_won"]
              },
              "refund_of": {
                "type": "string",
                "maxLength": 200
              },
              "product": {
                "type": "string",
                "maxLength": 200
              },
              "subscription": {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 200
                  },
                  "interval": {
                    "default": "month",
                    "type": "string",
                    "enum": ["day", "week", "month", "year"]
                  },
                  "interval_count": {
                    "default": 1,
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 36
                  },
                  "period_start": {
                    "type": "string",
                    "format": "date-time",
                    "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
                  },
                  "period_end": {
                    "type": "string",
                    "format": "date-time",
                    "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
                  }
                },
                "required": ["id"]
              }
            },
            "required": ["amount", "currency"]
          },
          "context": {
            "default": {},
            "type": "object",
            "properties": {
              "page": {
                "type": "object",
                "properties": {
                  "url": {
                    "type": "string",
                    "maxLength": 4096
                  },
                  "referrer": {
                    "type": "string",
                    "maxLength": 4096
                  },
                  "title": {
                    "type": "string",
                    "maxLength": 2048
                  }
                }
              },
              "app": {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string",
                    "maxLength": 2048
                  },
                  "version": {
                    "type": "string",
                    "maxLength": 2048
                  },
                  "build": {
                    "type": "string",
                    "maxLength": 2048
                  },
                  "namespace": {
                    "type": "string",
                    "maxLength": 2048
                  }
                }
              },
              "device": {
                "type": "object",
                "properties": {
                  "type": {
                    "type": "string",
                    "enum": ["desktop", "mobile", "tablet", "tv", "other"]
                  },
                  "manufacturer": {
                    "type": "string",
                    "maxLength": 2048
                  },
                  "model": {
                    "type": "string",
                    "maxLength": 2048
                  }
                }
              },
              "os": {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string",
                    "maxLength": 2048
                  },
                  "version": {
                    "type": "string",
                    "maxLength": 2048
                  }
                }
              },
              "screen": {
                "type": "object",
                "properties": {
                  "width": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 20000
                  },
                  "height": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 20000
                  },
                  "density": {
                    "type": "number",
                    "exclusiveMinimum": 0,
                    "maximum": 10
                  }
                }
              },
              "viewport": {
                "type": "object",
                "properties": {
                  "width": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 20000
                  },
                  "height": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 20000
                  }
                }
              },
              "locale": {
                "type": "string",
                "maxLength": 35
              },
              "languages": {
                "maxItems": 10,
                "type": "array",
                "items": {
                  "type": "string",
                  "maxLength": 35
                }
              },
              "timezone": {
                "type": "string",
                "maxLength": 64
              },
              "location": {
                "type": "object",
                "properties": {
                  "latitude": {
                    "type": "number",
                    "minimum": -90,
                    "maximum": 90
                  },
                  "longitude": {
                    "type": "number",
                    "minimum": -180,
                    "maximum": 180
                  }
                },
                "required": ["latitude", "longitude"]
              },
              "library": {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string",
                    "maxLength": 50
                  },
                  "version": {
                    "type": "string",
                    "maxLength": 30
                  }
                },
                "required": ["name", "version"]
              },
              "ip": {
                "type": "string",
                "maxLength": 45
              },
              "user_agent": {
                "type": "string",
                "maxLength": 1024
              }
            }
          },
          "consent": {
            "default": {
              "analytics": "unknown",
              "marketing": "unknown"
            },
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "analytics": {
                    "type": "string",
                    "enum": ["granted", "denied", "unknown"]
                  },
                  "marketing": {
                    "default": "unknown",
                    "type": "string",
                    "enum": ["granted", "denied", "unknown"]
                  }
                },
                "required": ["analytics"]
              },
              {
                "type": "string",
                "const": "not_applicable"
              }
            ]
          }
        },
        "required": ["event_id", "type", "event"]
      }
    }
  },
  "required": ["events"],
  "$id": "https://mirafive.io/schema/batch.schema.json",
  "title": "MIRA FIVE batch",
  "description": "A batch of events for POST https://events.mirafive.io/v1/batch (Authorization: Bearer <key>). Generated from the ingest's own schema."
}
